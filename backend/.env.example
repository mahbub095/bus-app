# -----------------------------------------------------------------------
# SonyaBus — Backend Environment Configuration
# Copy this file to .env and fill in your values before running the app.
# See documentation/index.html for full setup instructions.
# -----------------------------------------------------------------------

APP_NAME=SonyaBus
APP_ENV=production
APP_KEY=                          # Run: php artisan key:generate
APP_DEBUG=false                   # NEVER set true in production
APP_URL=https://your-backend-domain.com
APP_FRONTEND_URL=https://your-frontend-domain.com
APP_LICENSED=false                # Set automatically after license activation

# -----------------------------------------------------------------------
# Envato License — Required for activation
# Set your CodeCanyon item ID and author personal token here
#
# ENVATO_ITEM_ID  — Numeric ID found in your item URL
# ENVATO_PERSONAL_TOKEN — Author's personal token from build.envato.com
#   Required permissions: View your purchases of items (Verify purchases)
#   OR: View the user's sales history and search sales (for author/sale endpoint)
#
# LOCAL DEVELOPMENT ONLY — skip real Envato API verification:
#   ENVATO_SKIP_VERIFY=true  (only works when APP_ENV=local)
#   Any valid-format purchase code (UUID) will be accepted.
# -----------------------------------------------------------------------
ENVATO_ITEM_ID=
ENVATO_PERSONAL_TOKEN=
ENVATO_SKIP_VERIFY=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# -----------------------------------------------------------------------
# Database — MySQL recommended for production
# -----------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sonyabus
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password

# -----------------------------------------------------------------------
# Session / Queue / Cache — leave as database for production
# -----------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# -----------------------------------------------------------------------
# Mail (SMTP) — required for password reset emails
# -----------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=smtp.yourmailprovider.com
MAIL_PORT=587
MAIL_USERNAME=your@email.com
MAIL_PASSWORD=your_smtp_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"

# -----------------------------------------------------------------------
# ZiniPay Payment Gateway
# Obtain your API key from: https://zinipay.com
# -----------------------------------------------------------------------
ZINIPAY_API_KEY=
ZINIPAY_BASE_URL=https://api.zinipay.com

# -----------------------------------------------------------------------
# SMS Gateway — also configurable from Admin → Integrations → SMS
# Drivers: smsnetbd | bulksmsbd | get_query | custom
# -----------------------------------------------------------------------
SMS_GATEWAY_NAME=SMS.NET.BD
SMS_GATEWAY_DRIVER=smsnetbd
SMS_GATEWAY_API_URL=https://api.sms.net.bd/sendsms
SMS_GATEWAY_API_KEY=
SMS_GATEWAY_SENDER_ID=
SMS_GATEWAY_ACTIVE=true
SMS_GATEWAY_MESSAGE_TEMPLATE="SonyaBus ticket confirmed. PNR {PNR}, Seats {SEATS}, Fare BDT {FARE}. Status: {STATUS}"

# -----------------------------------------------------------------------
# Booking charge configuration (BDT per seat)
# Default values cancel each other out (charge = discount = 0 net extra)
# Adjust to add real service / gateway fees
# -----------------------------------------------------------------------
BOOKING_SERVICE_CHARGE=20
BOOKING_GATEWAY_CHARGE=16
BOOKING_SC_DISCOUNT=20
BOOKING_GC_DISCOUNT=16
BOOKING_DEFAULT_SEAT_CLASS=E-Class

VITE_APP_NAME="${APP_NAME}"
