# -----------------------------------------------------------------------
# SonyaBus Frontend — Environment Variables
# Copy this file to .env and fill in your values before running the app.
# -----------------------------------------------------------------------

# Full URL to the Laravel backend API (no trailing slash)
# In local dev this is usually http://localhost:8000/api
# In production set this to your live domain, e.g. https://yourdomain.com/api
VITE_API_BASE_URL=http://localhost:8000/api

# ZiniPay payment gateway API key
# Obtain from your ZiniPay merchant dashboard — https://zinipay.com
VITE_ZINIPAY_API_KEY=your_zinipay_api_key_here
